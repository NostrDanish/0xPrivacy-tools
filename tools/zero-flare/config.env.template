# Zero Flare config — copy to .env and edit as needed

# Default relay pool (comma-separated). Zero Flare will rotate among these.
RELAYS="wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net,wss://purplepag.es"

# Optional: pin a single relay (overrides RELAYS)
# RELAY="wss://nos.lol"

# Local relay passthrough port (set to 0 to disable)
LOCAL_RELAY_PORT=0

# Tor SOCKS5 port (must match docker-compose)
TOR_SOCKS_PORT=9150

# Nginx front-end port
NGINX_PORT=8080
